# Copy this file to `.env` and adjust only if you need a local backend.
# `.env` is git-ignored - each developer keeps their own copy.

# -----------------------------------------------------------------------------
# Backend API base URL
# -----------------------------------------------------------------------------
# Default remote backend. This works from installed APKs and physical devices
# without Metro, adb reverse, or your laptop being on the same network.
API_BASE_URL=https://amma-vljt.onrender.com/api

# For local backend development, replace the value above with the line that
# matches how you are running the app:
#
#   iOS simulator / adb-reversed Android USB:
#     API_BASE_URL=http://localhost:3000/api
#
#   Android emulator (AVD):
#     API_BASE_URL=http://10.0.2.2:3000/api
#
#   Physical phone over Wi-Fi (replace with YOUR laptop's LAN IP):
#     API_BASE_URL=http://192.168.1.5:3000/api

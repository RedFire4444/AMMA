# Copy this file to `.env` and adjust for your machine.
# `.env` is git-ignored — each developer keeps their own copy.

# -----------------------------------------------------------------------------
# Backend API base URL
# -----------------------------------------------------------------------------
# Pick the line that matches how you are running the app:
#
#   iOS simulator (Mac):
#     API_BASE_URL=http://localhost:3000/api
#
#   Android emulator (AVD):
#     API_BASE_URL=http://10.0.2.2:3000/api
#
#   Physical Android phone over USB (run `adb reverse tcp:3000 tcp:3000` once):
#     API_BASE_URL=http://localhost:3000/api
#
#   Physical phone over Wi-Fi (replace with YOUR laptop's LAN IP):
#     API_BASE_URL=http://192.168.1.5:3000/api
#
# Default: works for iOS simulator and adb-reversed Android USB.
API_BASE_URL=http://localhost:3000/api
